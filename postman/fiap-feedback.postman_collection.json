{
  "info": {
    "_postman_id": "93f1a454-f6a2-4c4e-92d4-0e7c58a5d1a0",
    "name": "FIAP Feedback Platform",
    "description": "Collection do Tech Challenge Fase 4. Configure baseUrl e functionKey.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:7071"
    },
    {
      "key": "functionKey",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Feedback normal",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-functions-key",
            "value": "{{functionKey}}",
            "disabled": false
          },
          {
            "key": "X-Correlation-Id",
            "value": "{{$guid}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"descricao\": \"A aula foi clara e objetiva.\",\n  \"nota\": 9\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/avaliacao",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "avaliacao"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 201', function () { pm.response.to.have.status(201); });",
              "pm.test('Correlation ID presente', function () { pm.expect(pm.response.headers.get('X-Correlation-Id')).to.not.be.null; });"
            ]
          }
        }
      ]
    },
